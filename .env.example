# コピーして .env を作成してください（.env はGitにコミットしない）
# cp .env.example .env

# Gemini（Google AI Studio で発行）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# LINE Messaging API（LINE Developers コンソール）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Push通知の送信先（チャネル基本設定の「あなたのユーザーID」）
LINE_DEMO_USER_ID=

# Google Cloud（Calendar / Sheets を使う場合）
GOOGLE_CLOUD_PROJECT=
